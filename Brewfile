# Tools these dotfiles rely on. Install with: brew bundle --file ~/dotfiles/Brewfile
brew "stow"       # symlink manager for the packages in this repo
brew "gitleaks"   # secret scanner, run before pushing
brew "gh"         # GitHub CLI (also used by the herdr prs mod)
brew "jq"         # used by the Claude status line script
brew "herdr"      # terminal workspace manager
brew "rtk"        # token-saving CLI proxy used by Claude Code (see claude/.claude/RTK.md)
